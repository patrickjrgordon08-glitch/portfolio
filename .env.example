# SMTP settings for the contact form (optional - if unset, inquiries are logged instead of emailed)
EMAIL_SERVER_HOST=
EMAIL_SERVER_PORT=2525
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
EMAIL_FROM=

# Calendly integration (optional - if unset, the site falls back to the static
# calendarUrl in src/libs/portfolioProfile.ts). Generate a Personal Access
# Token at https://calendly.com/integrations/api_webhooks and never commit
# the real value - keep it in .env.local only.
CALENDLY_API_TOKEN=
# Your Calendly user URI, e.g. https://api.calendly.com/users/<user_uuid>
CALENDLY_USER_URI=
